// get.fistron.io: a Worker that redirects to the newest release's install.sh
// (worker.mjs). No assets, no *.workers.dev address, no preview URLs; never
// behind Cloudflare Access, since hosts download the installer without a
// person. Deployed apart from the website: `npx wrangler deploy -c get/wrangler.jsonc`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "get-fistron-io",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "get.fistron.io", "custom_domain": true }],
  // the repository whose releases carry install.sh (public from general availability)
  "vars": { "REPOSITORY": "fistron-io/Fistron" }
}

---
/** Brand checkbox: filled (done, available) or empty (open, in development). */
interface Props {
  filled?: boolean;
  size?: number;
  /** Colour of the empty box outline. */
  outline?: string;
  class?: string;
}
const { filled = true, size = 16, outline = "var(--color-pending)", class: className } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 12 12" aria-hidden="true" class={className}>
  {
    filled ? (
      <>
        <rect x="0.5" y="0.5" width="11" height="11" rx="2.6" fill="var(--color-leaf)" />
        <path
          d="M3.2 6.2 L5.2 8.2 L8.9 4.1"
          fill="none"
          stroke="#ffffff"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </>
    ) : (
      <rect x="1" y="1" width="10" height="10" rx="2.4" fill="none" stroke={outline} stroke-width="1.3" />
    )
  }
</svg>

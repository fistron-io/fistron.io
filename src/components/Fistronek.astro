---
/**
 * Fištrónek, the Fistron crow, in one of eleven poses. The "skeptical",
 * "chase" and "quarantine" poses include Flaky, the flaky-test gremlin.
 *
 * The drawings are the brand's (src/brand/mascot/, copied unchanged from the
 * fistron-io/brand repository), inline so they follow the theme: in the dark
 * theme his outline is light (--crow-outline, --crow-leg in tokens.css) and he
 * works nights with a headlamp. Each pose moves one part; the animation
 * (fistronek.css, added once by BaseLayout) stops under prefers-reduced-motion.
 * Give `label` for meaningful illustrations; leave it empty for decorative ones.
 */
import { inlineSvg, uniqueId } from "../lib/brand-svg.mjs";

interface Props {
  pose:
    | "main"
    | "investigating"
    | "skeptical"
    | "chase"
    | "telescope"
    | "broom"
    | "stamp"
    | "conductor"
    | "chef"
    | "desk"
    | "quarantine";
  /** Accessible description. Empty means decorative (hidden from screen readers). */
  label?: string;
  class?: string;
}
const { pose, label = "", class: className } = Astro.props;

const files = import.meta.glob<string>("../brand/mascot/fistronek-*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const source = files[`../brand/mascot/fistronek-${pose}.svg`];
if (!source) throw new Error(`Fištrónek has no pose "${pose}"`);

// ids (Flaky's clipPath) unique on the page: one number per drawing rendered
const drawing = inlineSvg(source, uniqueId("fistronek"));

/** Shown only in the dark theme (global.css): strap, lamp and its beam on his forehead. */
const headlamp =
  `<g class="headlamp">` +
  `<path d="M149 49 L204 18 L204 58 L149 56 Z" fill="#ffe27a" opacity="0.28"/>` +
  `<path d="M96 65 Q111 45 140 51" stroke="var(--crow-leg)" stroke-width="4.5" stroke-linecap="round" fill="none"/>` +
  `<rect x="136" y="47" width="12" height="9" rx="2.7" fill="#f2c94c" stroke="var(--crow-outline)" stroke-width="1.5"/>` +
  `<circle cx="148" cy="51.5" r="2.9" fill="#ffe27a"/>` +
  `</g>`;
// On the head, right after the brow (the one line 4.5 wide): inside the crow's
// own group, so it moves and scales with him in every pose.
const brow = drawing.body.indexOf('stroke-width="4.5"');
const at = drawing.body.indexOf("/>", brow) + 2;
const body = brow < 0 ? drawing.body : drawing.body.slice(0, at) + headlamp + drawing.body.slice(at);
---

<svg
  viewBox={drawing.viewBox}
  class:list={["fistronek", className]}
  role={label ? "img" : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : "true"}
  set:html={body}
/>

<style>
  .fistronek {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

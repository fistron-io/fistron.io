---
import { site } from "../config/site";
import Wordmark from "./Wordmark.astro";
import Fistronek from "./Fistronek.astro";
import NavLink from "./NavLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="header">
  <div class="wrap bar">
    <div class="brand">
      <a href="/" class="home" aria-label="Fistron home"><Wordmark egg /></a>
      <div class="egg" aria-hidden="true"><Fistronek pose="main" /></div>
    </div>

    <nav aria-label="Main" class="nav">
      {site.nav.map((item) => <NavLink item={item} compact />)}
    </nav>

    <div class="actions">
      <ThemeToggle />
      <NavLink item={{ label: "Sign in", service: "app" }} class="signin" compact />
      <a href="/#demo" class="btn btn-primary cta">Request a demo</a>
    </div>

    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Main, small screens">
        {site.nav.map((item) => <NavLink item={item} />)}
        <NavLink item={{ label: "Sign in", service: "app" }} />
      </nav>
    </details>
  </div>
</header>

<script>
  // Easter egg: clicking the checkbox in the wordmark unticks it; Fištrónek
  // flies in, checks the evidence and ticks it back.
  const brand = document.querySelector<HTMLElement>(".brand");
  const box = brand?.querySelector<SVGElement>("[data-wordmark-box]");
  let running = false;
  box?.addEventListener("click", (event) => {
    event.preventDefault();
    event.stopPropagation();
    if (!brand || running) return;
    running = true;
    brand.classList.add("unticked");
    setTimeout(() => brand.classList.add("egg-on"), 250);
    setTimeout(() => brand.classList.remove("unticked"), 1300);
    setTimeout(() => {
      brand.classList.remove("egg-on");
      running = false;
    }, 2200);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--surface-page);
    border-bottom: 1px solid var(--color-line-soft);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .home {
    text-decoration: none;
  }
  .brand {
    position: relative;
  }
  .brand :global([data-wordmark-box]) {
    cursor: pointer;
  }
  .egg {
    position: absolute;
    left: calc(100% + 4px);
    top: -14px;
    width: 52px;
    opacity: 0;
    transform: translateX(80px);
    pointer-events: none;
  }
  .egg-on .egg {
    animation: fly-in 1.95s ease-in-out;
  }
  @keyframes fly-in {
    0% {
      opacity: 0;
      transform: translateX(80px) translateY(-10px);
    }
    25%,
    75% {
      opacity: 1;
      transform: translateX(0) translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateX(80px) translateY(-14px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .egg-on .egg {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  .nav {
    display: flex;
    gap: 20px;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .nav :global(a),
  .nav :global(.soon),
  .actions :global(.signin) {
    text-decoration: none;
    color: var(--color-ink-2);
  }
  .nav :global(a:hover),
  .actions :global(a.signin:hover) {
    color: var(--color-indigo);
  }
  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
    font-size: 0.9375rem;
  }
  .cta {
    padding: 11px 18px;
    white-space: nowrap;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    cursor: pointer;
    list-style: none;
    padding: 10px 14px;
    border: 1px solid var(--color-control);
    border-radius: var(--radius);
    font-weight: 500;
    color: var(--color-indigo);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 5;
    display: grid;
    min-width: 220px;
    padding: 8px;
    background: var(--surface-page);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
  }
  .menu nav :global(a),
  .menu nav :global(.soon) {
    padding: 10px 12px;
    text-decoration: none;
    color: var(--color-ink);
    border-radius: var(--radius-sm);
  }
  .menu nav :global(a:hover) {
    background: var(--color-paper);
  }

  @media (max-width: 1220px) {
    .nav,
    .actions :global(.signin) {
      display: none;
    }
    .menu {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .cta {
      display: none;
    }
  }
</style>

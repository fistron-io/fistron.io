---
/**
 * The Fistron wordmark as live text: the name with the brand checkbox above
 * the "s", its bottom edge level with the bottom of the dot on the "i" (as
 * logo/fistron-wordmark.svg of the brand repository draws it). With `egg`,
 * clicking the checkbox plays a small easter egg (see Header).
 */
interface Props {
  tone?: "light" | "dark";
  size?: number;
  egg?: boolean;
}
const { tone = "light", size = 26, egg = false } = Astro.props;
---

<span class:list={["wordmark", tone]} style={`font-size: ${size}px`}>
  Fi<span class="s"
    >s<svg viewBox="0 0 20 20" aria-hidden="true" data-wordmark-box={egg ? "" : undefined}>
      <rect class="empty" x="0.9" y="0.9" width="18.2" height="18.2" rx="4.1" fill="none" stroke="var(--color-pending)" stroke-width="1.8"
      ></rect>
      <g class="ticked">
        <rect width="20" height="20" rx="4.73" fill="var(--color-leaf)"></rect>
        <path
          d="M4.91 10.36 L8.55 14 L15.27 6.55"
          fill="none"
          stroke="#ffffff"
          stroke-width="3.45"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </g>
    </svg></span
  >tron
</span>

<style>
  .wordmark {
    display: inline-block;
    white-space: nowrap;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .light {
    color: var(--color-heading);
  }
  .dark {
    color: var(--color-white);
  }
  .s {
    position: relative;
  }
  svg {
    position: absolute;
    left: 50%;
    /* the box's bottom edge on the bottom of the i's dot (0.613em above the
     * baseline in IBM Plex Sans 500): the content area of the span starts
     * 1.0385em above the baseline, so 1.0385 - 0.613 - 0.32 = 0.105em */
    top: 0.105em;
    width: 0.32em;
    height: 0.32em;
    transform: translateX(-50%);
  }
  .empty {
    opacity: 0;
  }
  .ticked {
    transition: opacity 0.2s;
  }
  :global(.unticked) .empty {
    opacity: 1;
  }
  :global(.unticked) .ticked {
    opacity: 0;
  }
</style>

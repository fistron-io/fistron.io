---
/**
 * The Fistron wordmark: the name with a small filled checkbox where a ® would
 * sit. With `egg`, clicking the checkbox plays a small easter egg (see Header).
 */
interface Props {
  tone?: "light" | "dark";
  size?: number;
  egg?: boolean;
}
const { tone = "light", size = 26, egg = false } = Astro.props;
---

<span class:list={["wordmark", tone]} style={`font-size: ${size}px`}>
  Fistron<svg viewBox="0 0 12 12" aria-hidden="true" data-wordmark-box={egg ? "" : undefined}>
    <rect class="empty" x="1" y="1" width="10" height="10" rx="2.4" fill="none" stroke="var(--color-pending)" stroke-width="1.3"
    ></rect>
    <g class="ticked">
      <rect x="0.5" y="0.5" width="11" height="11" rx="2.6" fill="var(--color-leaf)"></rect>
      <path
        d="M3.2 6.2 L5.2 8.2 L8.9 4.1"
        fill="none"
        stroke="#ffffff"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </g>
  </svg>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: flex-start;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .light {
    color: var(--color-indigo);
  }
  .dark {
    color: var(--color-white);
  }
  svg {
    width: 0.34em;
    height: 0.34em;
    margin-left: 0.08em;
    margin-top: 0.04em;
  }
  .empty {
    opacity: 0;
  }
  .ticked {
    transition: opacity 0.2s;
  }
  :global(.unticked) .empty {
    opacity: 1;
  }
  :global(.unticked) .ticked {
    opacity: 0;
  }
</style>

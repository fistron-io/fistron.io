---
import StatusIcon from "./StatusIcon.astro";
import Working from "./Working.astro";

/** "Available now" (the status icon passed) or "In development" (running, and
 * Fištrónek at work beside it).
 * With ``href``, a link: to where the feature is described (its page of the guide). */
interface Props {
  status: "available" | "in-development";
  tone?: "light" | "dark";
  href?: string;
  title?: string; // what the link opens
}
const { status, tone = "light", href, title } = Astro.props;
const available = status === "available";
const label = available ? "Available now" : "In development";
const Tag = href ? "a" : "span";
---

<Tag class:list={["badge", tone, available ? "available" : "pending"]} href={href} title={title}>
  <StatusIcon state={available ? "passed" : "running"} size={14} />
  {label}
  {!available && <Working size={28} />}
</Tag>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
  }
  a.badge {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  a.badge:hover {
    text-decoration-thickness: 2px;
  }
  .light.available {
    color: var(--color-leaf-text);
  }
  .light.pending {
    color: var(--color-muted);
  }
  .dark.available {
    color: var(--color-leaf-light);
  }
  .dark.pending {
    color: var(--color-on-dark-muted);
  }
</style>

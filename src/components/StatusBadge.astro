---
import CheckIcon from "./CheckIcon.astro";

/**
 * "Available now" and "Implemented, validating" (filled checkbox, green: it
 * exists and works) or "In development" (empty checkbox).
 */
interface Props {
  status: "available" | "implemented" | "in-development";
  tone?: "light" | "dark";
}
const { status, tone = "light" } = Astro.props;
const done = status !== "in-development";
const label = { available: "Available now", implemented: "Implemented, validating", "in-development": "In development" }[
  status
];
---

<span class:list={["badge", tone, done ? "available" : "pending"]}>
  <CheckIcon filled={done} size={14} />
  {label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .light.available {
    color: var(--color-leaf-text);
  }
  .light.pending {
    color: var(--color-muted);
  }
  .dark.available {
    color: var(--color-leaf-light);
  }
  .dark.pending {
    color: var(--color-on-dark-muted);
  }
</style>

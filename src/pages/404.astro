---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
---

<BaseLayout title="Page not found">
  <Section tone="mist" contours={{ cx: 1060 }} labelledby="not-found-title">
    <div class="not-found">
      <h1 id="not-found-title">This page doesn't exist.</h1>
      <p class="lead">The address may be mistyped, or the page has moved.</p>
      <a href="/" class="btn btn-primary">Go to the homepage</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: 24px;
    justify-items: start;
    padding: 48px 0 64px;
  }
  h1 {
    font-size: var(--text-h2);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-indigo);
  }
</style>

---
import { section } from "../lib/content";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatusBadge from "../components/StatusBadge.astro";
import output from "../content/en/ci-output.txt?raw";

const copy = await section("ci");

/** Light highlighting: prompt, section headings, provenance and evidence refs dim; outcomes green. */
type Part = { text: string; kind?: "dim" | "ok" };
const headings = new Set(["Evidence", "Assessment", "Reconciliation"]);
const lines: Part[][] = output.trimEnd().split("\n").map((line) => {
  if (headings.has(line.trim())) return [{ text: line, kind: "dim" }];
  if (line.trimStart().startsWith("<-")) return [{ text: line, kind: "dim" }];
  if (line.startsWith("$")) return [{ text: "$", kind: "dim" }, { text: line.slice(1) }];
  return line
    .split(/(\[[^\]]+#[^\]]+\]|\bconcluded\b|\bacquired\b)/)
    .filter(Boolean)
    .map((text) =>
      text.startsWith("[") && text.includes("#")
        ? { text, kind: "dim" as const }
        : text === "concluded" || text === "acquired"
          ? { text, kind: "ok" as const }
          : { text },
    );
});
---

<Section tone="night" contours={{ cx: 1060, ring: true }} labelledby="ci-title">
  <div class="layout">
    <div class="text">
      <StatusBadge status="available" tone="dark" />
      <div class="heading">
        <SectionHeading id="ci-title" title={copy.title} tone="dark" />
      </div>
      {copy.paragraphs?.map((p) => <p class="para">{p}</p>)}
    </div>
    <figure class="terminal-wrap">
      <div class="terminal">
        <div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="scroll">
          <pre>{lines.map((parts) => (
            <>{parts.map((part) => part.kind ? <span class={part.kind}>{part.text}</span> : part.text)}{"\n"}</>
          ))}</pre>
        </div>
      </div>
      <figcaption>{copy.caption}</figcaption>
    </figure>
  </div>
</Section>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }
  .text {
    flex: 1 1 400px;
    min-width: 0;
  }
  .heading {
    margin-top: 16px;
  }
  .para {
    margin-top: 20px;
    font-size: 1.125rem;
    color: var(--color-on-dark);
  }
  .terminal-wrap {
    flex: 1.3 1 520px;
    min-width: 0;
    margin: 0;
  }
  .terminal {
    background: var(--color-night-deep);
    border: 1px solid var(--color-night-line);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .dots {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-night-line);
  }
  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-night-line);
  }
  .scroll {
    overflow-x: auto;
  }
  pre {
    margin: 0;
    padding: 20px 22px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-on-dark);
  }
  .dim {
    color: #8e97b8;
  }
  .ok {
    color: var(--color-leaf-light);
  }
  figcaption {
    margin-top: 12px;
    font-size: 0.8125rem;
    color: var(--color-on-dark-muted);
  }
</style>

---
import { list } from "../lib/content";
import Section from "../components/Section.astro";

/**
 * The homepage pillar for engineers (Fistron's founder, 2026-11-06): the
 * promise and its line from the engineers' entry of messages.yaml, what
 * Fistron does for their changes, and the solutions it links to. No claim
 * of results until they are measured.
 */
const messages = await list("messages");
const engineers = messages.find((m) => m.pillar !== undefined);
if (!engineers?.pillar) throw new Error("messages.yaml: no entry with a pillar for the homepage");
const pillar = engineers.pillar;
---

<Section id="engineers" tone="mist" labelledby="engineers-title">
  <div class="body">
    <div class="promise">
      <p class="kicker">{engineers.title}</p>
      <h2 id="engineers-title">{pillar.title}</h2>
      <p class="lead">{pillar.text}</p>
      {
        pillar.links.length > 0 && (
          <ul class="links">
            {pillar.links.map((l) => (
              <li>
                <a href={l.href}>{l.label} →</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <ul class="lines">
      {
        engineers.lines.map((line) => (
          <li>
            <span class="dot" aria-hidden="true" />
            <span>{line}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 48px;
    align-items: start;
  }
  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-indigo);
  }
  h2 {
    margin-top: 12px;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-heading);
  }
  .lead {
    margin-top: 16px;
    font-size: var(--text-lead);
    color: var(--color-ink-2);
  }
  .links {
    list-style: none;
    padding: 0;
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .links a {
    font-weight: 500;
  }
  .lines {
    list-style: none;
    padding: 0;
  }
  .lines li {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .lines li:first-child {
    padding-top: 0;
  }
  .dot {
    flex: 0 0 8px;
    height: 8px;
    margin-top: 0.6em;
    border-radius: 50%;
    background: var(--color-leaf);
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

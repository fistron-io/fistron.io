---
import { section, list } from "../lib/content";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatusBadge from "../components/StatusBadge.astro";
import Fistronek from "../components/Fistronek.astro";

const copy = await section("outcomes");
const pillars = await list("outcomes");
const messages = await list("messages");

/** Corners of the quality/schedule/cost triangle, in pillar order. */
const corners = [
  { x: 160, y: 34, labelY: 18, anchor: "middle" },
  { x: 36, y: 236, labelY: 268, anchor: "start" },
  { x: 284, y: 236, labelY: 268, anchor: "end" },
];
---

<Section id="outcomes" tone="mist" contours={{ cx: 1100 }} labelledby="outcomes-title">
  <div class="top">
    <div class="text">
      <SectionHeading id="outcomes-title" title={copy.title} intro={copy.intro}>
        <StatusBadge status="in-development" />
      </SectionHeading>
    </div>
    <figure class="tri">
      <svg
        class="triangle"
        viewBox="0 0 320 280"
        role="img"
        aria-label={`A triangle of ${pillars.map((p) => p.label.toLowerCase()).join(", ")}, each corner ticked`}
      >
        <polygon
          points={corners.map((c) => `${c.x},${c.y}`).join(" ")}
          fill="var(--color-white)"
          stroke="var(--color-indigo)"
          stroke-width="2"
          stroke-linejoin="round"
        />
        {
          corners.map((c, i) => (
            <g>
              <rect x={c.x - 9} y={c.y - 9} width="18" height="18" rx="4" fill="var(--color-leaf)" />
              <path
                d={`M${c.x - 4.5} ${c.y + 0.5} l3 3 l5.5 -6`}
                fill="none"
                stroke="#ffffff"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <text x={c.x} y={c.labelY} text-anchor={c.anchor} class="corner">
                {pillars[i]?.label}
              </text>
            </g>
          ))
        }
        <text x="160" y="170" text-anchor="middle" class="inside">less waste inside</text>
      </svg>
      <div class="sweeper"><Fistronek pose="broom" label="Fištrónek sweeping discarded tests out of the triangle" /></div>
      {copy.quip && <figcaption>{copy.quip}</figcaption>}
    </figure>
  </div>

  <div class="pillars">
    {
      pillars.map((p) => (
        <div class="pillar">
          <p class="label">{p.label}</p>
          <h3>{p.title}</h3>
          <p class="text">{p.text}</p>
        </div>
      ))
    }
  </div>

  <div class="messages">
    {
      messages.map((m) => (
        <div class="message">
          <h3>{m.title}</h3>
          <ul>
            {m.lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  {
    copy.paragraphs && (
      <div class="principles">
        {copy.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    )
  }
  {copy.note && <p class="note">{copy.note}</p>}
</Section>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 56px;
    align-items: center;
    justify-content: space-between;
  }
  .text {
    flex: 1 1 560px;
    min-width: 0;
  }
  .tri {
    flex: 0 1 390px;
    max-width: 390px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 104px;
    align-items: end;
  }
  .triangle {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .sweeper {
    margin: 0 0 6px -34px;
  }
  .tri figcaption {
    grid-column: 1 / -1;
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-align: center;
  }
  .corner {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    fill: var(--color-indigo);
  }
  .inside {
    font-family: var(--font-sans);
    font-size: 14px;
    fill: var(--color-muted);
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 40px;
    margin-top: 56px;
  }
  .pillar {
    border-top: 2px solid var(--color-leaf);
    padding-top: 20px;
  }
  .label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-leaf-text);
  }
  .pillar h3 {
    margin-top: 6px;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-indigo);
  }
  .pillar .text {
    margin-top: 8px;
    color: var(--color-muted);
  }
  .messages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 64px;
  }
  .message {
    background: var(--color-white);
    border-radius: var(--radius-panel);
    padding: 32px 36px;
  }
  .message h3 {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .message ul {
    list-style: none;
    padding: 0;
    margin-top: 14px;
    display: grid;
    gap: 12px;
  }
  .message li {
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-indigo);
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 16px 40px;
    margin-top: 48px;
    max-width: 62em;
  }
  .principles p {
    color: var(--color-ink-2);
  }
  .note {
    margin-top: 28px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .messages {
      grid-template-columns: 1fr;
    }
    .message {
      padding: 28px 24px;
    }
  }
</style>

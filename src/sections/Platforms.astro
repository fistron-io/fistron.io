---
import { section, list } from "../lib/content";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PlatformCard from "../components/PlatformCard.astro";
import Fistronek from "../components/Fistronek.astro";

const copy = await section("platforms");
const platforms = await list("platforms");
---

<Section id="platforms" labelledby="platforms-title">
  <div class="top">
    <div class="text">
      <SectionHeading id="platforms-title" title={copy.title} intro={copy.intro} />
    </div>
    <figure class="art">
      <Fistronek pose="conductor" label="Fištrónek conducting with a baton" />
      {copy.quip && <figcaption>{copy.quip}</figcaption>}
    </figure>
  </div>
  <ul class="platforms featured">
    {platforms.filter((p) => p.featured).map((platform) => <PlatformCard platform={platform} />)}
  </ul>
  <p class="note">{copy.note}</p>
  <details class="more">
    <summary>{copy.linkLabel}</summary>
    <p class="caption">{copy.caption}</p>
    <ul class="platforms">
      {platforms.filter((p) => !p.featured).map((platform) => <PlatformCard platform={platform} />)}
    </ul>
  </details>
  <div class="evidence">
    {copy.paragraphs?.map((p) => <p>{p}</p>)}
    <a href="/#demo">{copy.primaryCta}</a>
  </div>
</Section>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: center;
    justify-content: space-between;
  }
  .text {
    flex: 1 1 520px;
    min-width: 0;
  }
  .art {
    flex: 0 1 230px;
    max-width: 230px;
    margin: 0 auto;
  }
  figcaption {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-align: center;
  }
  .platforms {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .featured {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 40px;
  }
  .note, .caption {
    margin-top: 20px;
    color: var(--color-muted);
    font-size: 0.9375rem;
    max-width: 76ch;
  }
  .more {
    margin-top: 28px;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 20px 0;
  }
  summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--color-indigo);
  }
  summary:focus-visible {
    outline: 2px solid var(--color-indigo);
    outline-offset: 6px;
  }
  .more[open] { padding-bottom: 24px; }
  .evidence {
    margin-top: 28px;
    padding: 24px 28px;
    background: var(--color-paper);
    border-radius: var(--radius-card);
    color: var(--color-ink-2);
  }
  .evidence p + p { margin-top: 10px; }
  .evidence a {
    display: inline-block;
    margin-top: 16px;
    font-weight: 500;
  }
  @media (max-width: 1100px) {
    .platforms, .featured { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .platforms, .featured { grid-template-columns: 1fr; }
    .evidence { padding: 22px; }
  }
</style>

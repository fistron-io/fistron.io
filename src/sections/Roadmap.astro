---
import { section, list } from "../lib/content";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";

const copy = await section("roadmap");
const stages = await list("roadmap");
---

<Section labelledby="roadmap-title">
  <SectionHeading id="roadmap-title" title={copy.title} intro={copy.intro} />
  <ol class="stages">
    {
      stages.map((s) => (
        <li class:list={{ current: s.current }} aria-current={s.current ? "step" : undefined}>
          <span class="stage">{s.stage}</span>
          <span class="title">{s.title}</span>
          <p class="detail">{s.detail}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .stages {
    list-style: none;
    padding: 0;
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 24px;
    min-width: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
  }
  .current {
    grid-column: span 2;
    border-color: var(--color-leaf-text);
    background: var(--color-paper);
  }
  .stage {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .current .stage {
    font-weight: 500;
    color: var(--color-leaf-text);
  }
  .title {
    font-size: 1.0625rem;
    font-weight: 500;
  }
  .detail {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }
  @media (max-width: 1000px) {
    .stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .stages { grid-template-columns: 1fr; }
    .current { grid-column: auto; }
  }
</style>

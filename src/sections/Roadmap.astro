---
import { section, list } from "../lib/content";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Fistronek from "../components/Fistronek.astro";
import CheckIcon from "../components/CheckIcon.astro";

const copy = await section("roadmap");
const stages = await list("roadmap");
---

<Section id="roadmap" labelledby="roadmap-title">
  <div class="top">
    <div class="text">
      <SectionHeading id="roadmap-title" title={copy.title} intro={copy.intro} />
    </div>
    <figure class="art">
      <Fistronek pose="telescope" label="Fištrónek looking ahead through a telescope" />
      {copy.caption && <figcaption>{copy.caption}</figcaption>}
    </figure>
  </div>
  <ol class="stages">
    {
      stages.map((s) => (
        <li class:list={[s.status, { current: s.current }]} aria-current={s.current ? "step" : undefined}>
          <span class="stage">
            {s.status !== "planned" && <CheckIcon filled={s.status === "implemented"} size={14} />}
            {s.stage}
          </span>
          <span class="title">{s.title}</span>
          <p class="detail">{s.detail}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: center;
    justify-content: space-between;
  }
  .text {
    flex: 1 1 520px;
    min-width: 0;
  }
  .art {
    flex: 0 1 230px;
    max-width: 230px;
    margin: 0 auto;
  }
  figcaption {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-align: center;
  }
  .stages {
    list-style: none;
    padding: 0;
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 24px;
    min-width: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
  }
  /* Several stages can be in development at once: equal cells keep the order readable. */
  .current {
    border-color: var(--color-indigo);
    background: var(--color-paper);
  }
  .stage {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .stage :global(svg) {
    flex: none;
    margin-top: 0.2em;
  }
  /* Green means done, as everywhere on the site (StatusBadge). */
  .implemented .stage {
    font-weight: 500;
    color: var(--color-leaf-text);
  }
  .current .stage {
    font-weight: 500;
    color: var(--color-indigo);
  }
  .title {
    font-size: 1.0625rem;
    font-weight: 500;
  }
  .detail {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }
  @media (max-width: 1000px) {
    .stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .stages { grid-template-columns: 1fr; }
  }
</style>

---
import { section, list } from "../lib/content";
import Section from "../components/Section.astro";
import HeadingWithArt from "../components/HeadingWithArt.astro";

const copy = await section("dogfood");
const runs = await list("dogfood");
const stats = await list("dogfoodStats");
---

<Section id="dogfooding" tone="mist" contours={{ cx: 1180 }} labelledby="dogfood-title">
  <HeadingWithArt
    id="dogfood-title"
    title={copy.title}
    intro={copy.intro}
    pose="chef"
    label="Fištrónek in a chef's hat, tasting from a pot marked with the Fistron checkbox"
    caption={copy.quip}
  />

  <ol class="runs">
    {
      runs.map((r) => (
        <li>
          <h3>{r.when}</h3>
          <p>{r.text}</p>
        </li>
      ))
    }
  </ol>

  <dl class="stats">
    {
      stats.map((s) => (
        <div class="stat">
          <dt>{s.value}</dt>
          <dd>{s.text}</dd>
        </div>
      ))
    }
  </dl>

  {copy.paragraphs?.map((p) => <p class="story">{p}</p>)}
  {copy.note && <p class="note">{copy.note}</p>}
</Section>

<style>
  .runs {
    list-style: none;
    padding: 0;
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .runs li {
    border-top: 2px solid var(--color-indigo);
    padding-top: 20px;
  }
  h3 {
    font-size: 1.1875rem;
    font-weight: 500;
    color: var(--color-heading);
  }
  .runs p {
    margin-top: 8px;
    color: var(--color-muted);
  }
  .stats {
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .stat {
    background: var(--surface-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 22px 24px;
  }
  dt {
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    font-variant-numeric: tabular-nums;
  }
  dd {
    margin: 8px 0 0;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }
  .story {
    margin-top: 32px;
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-heading);
    max-width: 44em;
  }
  .note {
    margin-top: 16px;
    font-size: 0.875rem;
    color: var(--color-muted);
    max-width: 60em;
  }
  @media (max-width: 1000px) {
    .runs {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>

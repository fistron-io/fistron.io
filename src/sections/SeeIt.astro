---
/**
 * A solution's showcase: Fistron's own GUI on the demo's documents, taken at
 * each release (showcase.json and public/showcase/, synced from Fistron), in
 * the theme the visitor reads in, with what you do, what Fistron does and
 * what you get. Each picture opens enlarged on a click; a solution with
 * nothing real to show yet says why (pending).
 */
import Section from "../components/Section.astro";
import showcase from "../content/en/showcase.json";
import { site } from "../config/site";

interface Props {
  id: string;
}
interface Picture {
  name: string;
  alt: string;
  caption: string;
}
const found = showcase.solutions.find((s) => s.id === Astro.props.id) as
  | { id: string; you_do: string; fistron_does: string; you_get: string; guide: string; pictures: Picture[]; pending?: string }
  | undefined;
const pictures = found?.pictures ?? [];
const base = (picture: Picture) => `/showcase/${found!.id}/${picture.name}`;
const steps = found
  ? [
      { label: "You do", text: found.you_do },
      { label: "Fistron does", text: found.fistron_does },
      { label: "You get", text: found.you_get },
    ]
  : [];
---

{
  found && (pictures.length > 0 || found.pending) && (
    <Section labelledby="see-it-title" tone="mist">
      <h2 id="see-it-title">See it</h2>
      <div class="slides" data-slides aria-roledescription="carousel" aria-label="Pictures of the solution">
      {pictures.length > 1 && (
        <div class="controls" data-controls hidden>
          <button type="button" class="arrow" data-previous aria-label="The previous picture">‹</button>
          <div class="dots">
            {pictures.map((picture, index) => (
              <button type="button" class="dot" data-dot={index} aria-label={`Picture ${index + 1}: ${picture.alt}`} />
            ))}
          </div>
          <span class="count" data-count aria-live="polite">1 of {pictures.length}</span>
          <button type="button" class="arrow" data-next aria-label="The next picture">›</button>
        </div>
      )}
      {pictures.map((picture, index) => (
        <figure class="slide" data-slide aria-roledescription="slide" aria-label={`${index + 1} of ${pictures.length}`}>
          <button type="button" class="zoom" data-zoom aria-label={`Enlarge: ${picture.alt}`}>
            <picture>
              <source media="(max-width: 600px)" srcset={`${base(picture)}-phone.png`} />
              <img class="light" src={`${base(picture)}-light.png`} alt={picture.alt} width="1440" height="900" loading="lazy" />
            </picture>
            <img class="dark" src={`${base(picture)}-dark.png`} alt={picture.alt} width="1440" height="900" loading="lazy" />
          </button>
          <figcaption>
            {picture.caption} Taken from Fistron's GUI at its release, never drawn. Click to enlarge. More in{" "}
            <a href={`${site.services.docs.url}/${found.guide}/`}>the guide</a>.
          </figcaption>
        </figure>
      ))}
      </div>
      {pictures.length === 0 && found.pending && (
        <p class="pending">
          No picture yet: {found.pending} Until then, <a href={`${site.services.docs.url}/${found.guide}/`}>the guide</a>{" "}
          says what works today.
        </p>
      )}
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <h3>{step.label}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <dialog class="enlarged" aria-label="The picture enlarged">
        <button type="button" class="close" aria-label="Close">×</button>
        <img alt="" />
      </dialog>
    </Section>
  )
}

<script>
  // several pictures: one at a time, the others a click (or an arrow key) away; without
  // scripts every picture stays shown, one under another
  for (const slides of document.querySelectorAll<HTMLElement>("[data-slides]")) {
    const figures = [...slides.querySelectorAll<HTMLElement>("[data-slide]")];
    const controls = slides.querySelector<HTMLElement>("[data-controls]");
    if (figures.length < 2 || !controls) continue;
    const dots = [...controls.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const count = controls.querySelector<HTMLElement>("[data-count]");
    let at = 0;
    const show = (index: number) => {
      at = (index + figures.length) % figures.length;
      figures.forEach((figure, i) => (figure.hidden = i !== at));
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === at)));
      if (count) count.textContent = `${at + 1} of ${figures.length}`;
    };
    controls.hidden = false;
    controls.querySelector("[data-previous]")?.addEventListener("click", () => show(at - 1));
    controls.querySelector("[data-next]")?.addEventListener("click", () => show(at + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => show(i)));
    slides.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(at - 1);
      if (event.key === "ArrowRight") show(at + 1);
    });
    show(0);
  }

  // a picture opens enlarged: the one the visitor sees (its theme, its size), closed by a click or Escape
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-zoom]")) {
    button.addEventListener("click", () => {
      const dialog = button.closest("section")?.querySelector<HTMLDialogElement>("dialog.enlarged");
      const shown = [...button.querySelectorAll<HTMLImageElement>("img")].find((img) => img.offsetParent !== null);
      const large = dialog?.querySelector("img");
      if (!dialog || !shown || !large) return;
      large.src = shown.currentSrc || shown.src;
      large.alt = shown.alt;
      dialog.showModal();
    });
  }
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog.enlarged")) {
    dialog.addEventListener("click", () => dialog.close());
  }
</script>

<style>
  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  figure {
    margin: 24px 0 0;
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
    justify-content: flex-start;
  }
  .controls[hidden] {
    display: none;
  }
  .arrow {
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-heading);
    background: var(--color-paper);
    cursor: pointer;
  }
  .dots {
    display: flex;
    gap: 8px;
  }
  .dot {
    width: 12px;
    height: 12px;
    padding: 0;
    border: 1px solid var(--color-heading);
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
  }
  .dot[aria-current="true"] {
    background: var(--color-heading);
  }
  .count {
    font-size: 0.9rem;
    color: var(--color-ink-2);
  }
  .slide[hidden] {
    display: none;
  }
  .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .zoom:focus-visible {
    outline: 2px solid var(--color-leaf);
    outline-offset: 4px;
    border-radius: 8px;
  }
  .pending {
    margin-top: 16px;
    color: var(--color-ink-2);
  }
  .enlarged {
    max-width: 96vw;
    max-height: 96vh;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: var(--color-paper);
    cursor: zoom-out;
  }
  .enlarged::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  .enlarged img {
    width: auto;
    max-width: 96vw;
    max-height: 96vh;
    border: 0;
  }
  .enlarged .close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 20px;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-white);
    background: var(--color-night);
    cursor: pointer;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line-soft);
    border-radius: 8px;
  }
  .dark {
    display: none;
  }
  :root[data-theme="dark"] .light {
    display: none;
  }
  :root[data-theme="dark"] .dark {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .light {
      display: none;
    }
    :root:not([data-theme="light"]) .dark {
      display: block;
    }
  }
  @media (max-width: 600px) {
    .dark {
      display: none !important;
    }
    .light {
      display: block !important;
    }
  }
  figcaption {
    margin-top: 12px;
    font-size: 0.95rem;
    color: var(--color-ink-2);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .steps h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  .steps p {
    margin-top: 8px;
    color: var(--color-ink-2);
  }
  @media (max-width: 800px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

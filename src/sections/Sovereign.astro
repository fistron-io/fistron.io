---
import { section, list } from "../lib/content";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatusBadge from "../components/StatusBadge.astro";

/** The Fistron Sovereign variants: rules, or Fistron's own model. */
interface Props {
  link?: boolean;
}
const { link = true } = Astro.props;
const copy = await section("sovereign");
const variants = await list("sovereign");
---

<Section id="sovereign" tone="mist" labelledby="sovereign-title">
  <SectionHeading id="sovereign-title" title={copy.title} intro={copy.intro} />
  <ul class="variants">
    {
      variants.map((v) => (
        <li class:list={{ first: v.order === 0 }}>
          <StatusBadge status={v.status} />
          <h3>{v.title}</h3>
          <p class="tagline">{v.tagline}</p>
          <p class="text">{v.text}</p>
        </li>
      ))
    }
  </ul>
  <p class="note">
    {copy.note}
    {link && copy.linkLabel && <a href="/solutions/sovereignty/">{copy.linkLabel} →</a>}
  </p>
</Section>

<style>
  .variants {
    list-style: none;
    padding: 0;
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .variants li {
    background: var(--surface-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 24px;
  }
  .variants h3 {
    margin-top: 12px;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  .tagline {
    margin-top: 6px;
    font-weight: 500;
    color: var(--color-ink-2);
  }
  .text {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .note {
    margin-top: 28px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .note a {
    margin-left: 8px;
    font-weight: 500;
  }
</style>

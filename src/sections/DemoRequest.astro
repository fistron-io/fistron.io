---
import { section } from "../lib/content";
import { site } from "../config/site";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Fistronek from "../components/Fistronek.astro";
import CheckIcon from "../components/CheckIcon.astro";

const copy = await section("demo");
const action = site.demoFormAction;
---

<Section id="demo" tone="indigo" contours={{ cx: 1060, ring: true }} labelledby="demo-title">
  <div class="layout">
    <div class="text">
      <SectionHeading id="demo-title" title={copy.title} intro={copy.intro} tone="dark" />
    </div>
    <form class="form" method="post" action={action} data-connected={action ? "true" : "false"}>
      <div class="pair">
        <label>Name<input type="text" name="name" autocomplete="name" placeholder="Jana Nováková" required /></label>
        <label
          >Work email<input type="email" name="email" autocomplete="email" placeholder="jana@company.com" required
          /></label
        >
      </div>
      <label>Company<input type="text" name="company" autocomplete="organization" placeholder="Company name" /></label>
      <label
        >What should Fistron check for you?<textarea
          name="message"
          rows="4"
          placeholder="Our release reviews take two days because evidence is spread across Jenkins, TestRail and Grafana."
        ></textarea></label
      >
      <button type="submit" class="btn btn-primary">{copy.primaryCta}</button>
      <p class="notice" role="status" hidden>{copy.note}</p>
      <p class="error" role="alert" hidden>{copy.errorText}</p>
    </form>
    <div class="success" role="status" tabindex="-1" hidden>
      <div class="success-crow"><Fistronek pose="main" /></div>
      <div>
        <p class="success-label"><CheckIcon size={16} />{copy.successLabel}</p>
        <p class="success-title">{copy.successTitle}</p>
        <p class="success-text">{copy.successText}</p>
      </div>
    </div>
  </div>
</Section>

<script>
  // No endpoint configured (site.demoFormAction): don't submit, say so instead.
  // With an endpoint: send in the background and show the result in place.
  for (const form of document.querySelectorAll<HTMLFormElement>("form.form")) {
    const connected = form.dataset.connected === "true";
    const notice = form.querySelector<HTMLElement>(".notice");
    const error = form.querySelector<HTMLElement>(".error");
    const success = form.parentElement?.querySelector<HTMLElement>(".success");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!connected) {
        if (notice) notice.hidden = false;
        return;
      }
      if (error) error.hidden = true;
      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.focus();
        }
      } catch {
        if (error) error.hidden = false;
      }
    });
  }
</script>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }
  .text {
    flex: 1 1 400px;
    min-width: 0;
  }
  .form {
    flex: 1 1 420px;
    min-width: 0;
    display: grid;
    gap: 18px;
    background: var(--color-white);
    color: var(--color-ink);
    border-radius: var(--radius-panel);
    padding: 32px;
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px;
  }
  label {
    display: grid;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  input,
  textarea {
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    padding: 11px 12px;
    border: 1px solid var(--color-control);
    border-radius: var(--radius);
    color: var(--color-ink);
  }
  textarea {
    resize: vertical;
  }
  button {
    justify-self: start;
  }
  .notice,
  .error {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .error {
    color: #b42318;
  }
  .success {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: center;
    background: var(--color-white);
    color: var(--color-ink);
    border-radius: var(--radius-panel);
    padding: 32px 36px;
  }
  .success[hidden] {
    display: none;
  }
  .success-crow {
    flex: 0 0 130px;
  }
  .success-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-leaf-text);
  }
  .success-title {
    margin-top: 8px;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-indigo);
  }
  .success-text {
    margin-top: 10px;
    color: var(--color-ink-2);
  }
  @media (max-width: 640px) {
    .form {
      padding: 24px 20px;
    }
  }
</style>

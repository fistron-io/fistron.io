---
import { section } from "../lib/content";
import { site } from "../config/site";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";

const copy = await section("demo");
const action = site.demoFormAction;
---

<Section id="demo" tone="indigo" contours={{ cx: 1060, ring: true }} labelledby="demo-title">
  <div class="layout">
    <div class="text">
      <SectionHeading id="demo-title" title={copy.title} intro={copy.intro} tone="dark" />
    </div>
    <form class="form" method="post" action={action} data-connected={action ? "true" : "false"}>
      <div class="pair">
        <label>Name<input type="text" name="name" autocomplete="name" placeholder="Jana Nováková" required /></label>
        <label
          >Work email<input type="email" name="email" autocomplete="email" placeholder="jana@company.com" required
          /></label
        >
      </div>
      <label>Company<input type="text" name="company" autocomplete="organization" placeholder="Company name" /></label>
      <label
        >What should Fistron check for you?<textarea
          name="message"
          rows="4"
          placeholder="Our release reviews take two days because evidence is spread across Jenkins, TestRail and Grafana."
        ></textarea></label
      >
      <button type="submit" class="btn btn-primary">{copy.primaryCta}</button>
      <p class="notice" role="status" hidden>{copy.note}</p>
    </form>
  </div>
</Section>

<script>
  // Until a form endpoint is configured (site.demoFormAction), don't submit: say so instead.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-connected='false']")) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const notice = form.querySelector<HTMLElement>(".notice");
      if (notice) notice.hidden = false;
    });
  }
</script>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }
  .text {
    flex: 1 1 400px;
    min-width: 0;
  }
  .form {
    flex: 1 1 420px;
    min-width: 0;
    display: grid;
    gap: 18px;
    background: var(--color-white);
    color: var(--color-ink);
    border-radius: var(--radius-panel);
    padding: 32px;
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px;
  }
  label {
    display: grid;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  input,
  textarea {
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    padding: 11px 12px;
    border: 1px solid var(--color-control);
    border-radius: var(--radius);
    color: var(--color-ink);
  }
  textarea {
    resize: vertical;
  }
  button {
    justify-self: start;
  }
  .notice {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .form {
      padding: 24px 20px;
    }
  }
</style>

---
import { section, list } from "../lib/content";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatusBadge from "../components/StatusBadge.astro";
import Fistronek from "../components/Fistronek.astro";

const copy = await section("governance");
const items = await list("governance");
---

<Section labelledby="governance-title">
  <SectionHeading id="governance-title" title={copy.title} intro={copy.intro}>
    <StatusBadge status="implemented" />
  </SectionHeading>
  <div class="grid">
    {
      items.map((i) => (
        <div class="item">
          <h3>{i.title}</h3>
          <p>{i.text}</p>
        </div>
      ))
    }
    <figure class="art">
      <div class="crow"><Fistronek pose="stamp" label="Fištrónek stamping a report with a green checkbox" /></div>
      {copy.caption && <figcaption>{copy.caption}</figcaption>}
    </figure>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px;
    margin-top: 48px;
  }
  .art {
    grid-column: span 2;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .crow {
    width: 200px;
    flex: none;
  }
  figcaption {
    font-size: 0.875rem;
    color: var(--color-muted);
    max-width: 14em;
  }
  @media (max-width: 600px) {
    .art {
      grid-column: auto;
      flex-direction: column;
    }
    figcaption {
      text-align: center;
    }
  }
  .item {
    border-top: 2px solid var(--color-leaf);
    padding-top: 20px;
  }
  h3 {
    font-size: 1.1875rem;
    font-weight: 500;
  }
  p {
    margin-top: 8px;
    font-size: 1rem;
    color: var(--color-muted);
  }
</style>

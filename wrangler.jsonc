// Cloudflare Workers configuration: serves the static build in dist/.
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fistron-io",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Served only on fistron.io, behind Cloudflare Access while private.
  // No *.workers.dev address and no public preview URLs that would bypass Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "fistron.io", "custom_domain": true }]
}
